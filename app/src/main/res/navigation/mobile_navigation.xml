<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.isetr.tp5app.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_liste"
        android:name="com.isetr.tp5app.ui.liste.ListeFragment"
        android:label="@string/menu_liste"
        tools:layout="@layout/fragment_liste">
        <action
            android:id="@+id/action_nav_liste_to_detailEtudiant"
            app:destination="@id/nav_detail_etudiant" />
    </fragment>

    <fragment
        android:id="@+id/nav_ajout"
        android:name="com.isetr.tp5app.ui.ajout.AjoutFragment"
        android:label="@string/menu_ajout"
        tools:layout="@layout/fragment_ajout">
        <!-- Conformité TP6 : on retire l'écran d'ajout de la back stack. -->
        <action
            android:id="@+id/action_nav_ajout_etudiant_to_nav_liste_etudiants"
            app:destination="@id/nav_liste"
            app:popUpTo="@id/nav_ajout"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_detail_etudiant"
        android:name="com.isetr.tp5app.ui.detail.DetailEtudiantFragment"
        android:label="@string/menu_detail"
        tools:layout="@layout/fragment_detail_etudiant" />
</navigation>
